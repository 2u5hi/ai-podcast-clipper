{
  "CORSRules": [
    {
      "AllowedHeaders": [
        "Content-Type",
        "Content-Length"
      ],
      "AllowedMethods": [
        "PUT",
        "GET",
        "HEAD"
      ],
      "AllowedOrigins": [
        "http://localhost:3000"
      ],
      "ExposeHeaders": [
        "ETag"
      ],
      "MaxAgeSeconds": 3600
    }
  ]
}
