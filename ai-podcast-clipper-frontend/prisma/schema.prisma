// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  password         String
  credits          Int       @default(0)
  stripeCustomerId String?   @unique
  // the creator's own watermark once they've bought credits; null means none (ADR 0016)
  watermarkText    String?
  image            String?

  uploadedFiles UploadedFile[]
  clips         Clip[]
  creditEntries CreditLedgerEntry[]
}

model UploadedFile {
  id            String    @id @default(cuid())
  s3Key         String
  displayName   String?
  uploaded      Boolean   @default(false)
  status        JobStatus @default(QUEUED)
  // shown to the user when status is FAILED; the full error stays in Inngest's run log
  failureReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  clips         Clip[]
  creditEntries CreditLedgerEntry[]

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([s3Key])
}

model Clip {
  id    String @id @default(cuid())
  s3Key String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  uploadedFile   UploadedFile? @relation(fields: [uploadedFileId], references: [id], onDelete: Cascade)
  uploadedFileId String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([s3Key])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum CreditReason {
  OPENING_BALANCE // balances that existed before the ledger
  SIGNUP_GRANT
  PURCHASE
  PURCHASE_REFUND // a Stripe refund taking back a pack's credits (never below zero)
  JOB_RESERVE // taken when a job starts
  JOB_REFUND // the part of a reservation a job didn't use
  ADMIN_ADJUSTMENT
}

// Every change to User.credits writes one row here in the same transaction (ADR 0013),
// so a balance always equals the sum of its user's deltas.
model CreditLedgerEntry {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta          Int
  reason         CreditReason
  uploadedFileId String?
  uploadedFile   UploadedFile? @relation(fields: [uploadedFileId], references: [id], onDelete: SetNull)
  // unique, so a Stripe event retried after it was applied can't add credits twice
  stripeEventId  String?       @unique
  createdAt      DateTime      @default(now())

  @@index([userId, createdAt])
}

// Fixed-window counters for rate limits (ADR 0015); one row per key per window.
model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}

enum JobStatus {
  QUEUED
  PROCESSING
  PROCESSED // finished; may have 0 clips when no moments were found (credits refunded)
  FAILED // credits refunded; failureReason says why
  NO_CREDITS
}
